# Optional settings. Copy to .env to override the defaults.

# Saved X login for full threads and Articles.
# XAVE_STORAGE_STATE=./storage_state.json

# PDF paper size: A4, Letter, Legal, etc.
# XAVE_PAGE_FORMAT=A4

# Browser navigation and PDF rendering timeouts, in milliseconds.
# XAVE_NAV_TIMEOUT_MS=45000
# XAVE_RENDER_TIMEOUT_MS=120000
